# Copy to .env and fill in real values. Never commit .env.

# Prisma / SQL Server
# Example: sqlserver://HOST:1433;databaseName=YOUR_DB;user=YOUR_USER;password=YOUR_PASSWORD;trustServerCertificate=true;encrypt=true;
DATABASE_URL="sqlserver://localhost:1433;databaseName=YOUR_DB;user=YOUR_USER;password=YOUR_PASSWORD;trustServerCertificate=true;encrypt=true;"

# NextAuth
# Prefer matching the URL you open in the browser (localhost or LAN IP).
# AUTH_TRUST_HOST lets NextAuth accept the request Host when using a LAN IP.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string
AUTH_TRUST_HOST=true

# App URLs (optional)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email (optional)
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@example.com
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_FROM=noreply@example.com
